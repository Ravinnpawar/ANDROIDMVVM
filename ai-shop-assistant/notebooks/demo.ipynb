import os, sys
sys.path.insert(0, '/workspace/ai-shop-assistant')

from app.database import ProductDatabase
from app.chatbot import Chatbot

db = ProductDatabase()
bot = Chatbot(db)

queries = [
    'price of raisins',
    'do you deliver to home?',
    'return policy?',
    'मला बदामाचा भाव सांगा',  # Marathi: price of almonds
    'थोक माल मिळेल का?',       # Marathi: bulk order?
    'किशमिशचा रेट काय आहे?'    # Marathi: rate of raisins
]

for q in queries:
    print('User:', q)
    print('Bot :', bot.handle_message(q))
    print('-' * 40)
# AI Shop Assistant - Demo

This notebook demonstrates the core features:
- FAQ answers (delivery, returns, bulk)
- Product lookup (e.g., price of raisins)
- AI fallback via OpenAI (if `OPENAI_API_KEY` is set)
